#!/bin/bash

# ============================
# WARNA & VISUAL PREMIUM
# ============================
GR="\e[38;5;82m"
RD="\e[38;5;196m"
YL="\e[38;5;226m"
CY="\e[38;5;51m"
PR="\e[38;5;207m"
WH="\e[97m"
NC="\e[0m"

loading_bar() {
    local total=$1; local current=0; local width=40
    while [ "$current" -le "$total" ]; do
        local filled=$((current * width / total))
        local empty=$((width - filled))
        local bar=$(printf "%${filled}s" | tr ' ' "▰")
        bar+=$(printf "%${empty}s" | tr ' ' "▱")
        printf "\r ${CY}[${bar}]${NC} ${WH}%d%%${NC}" $((current * 100 / total))
        sleep 0.05; ((current++))
    done
    echo -e "\n"
}

print_header() {
    clear
    echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "          ${WH}PREMIUM UPDATE — TUNNEL OFFICIAL EDITION${NC}"
    echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ============================
# KONFIGURASI URL & PASSWORD
# ============================
ZIP_URL="https://raw.githubusercontent.com/mudziboy/tunv2/main/project/project.zip"
API_URL="https://raw.githubusercontent.com/mudziboy/doldol/main/api.js"

# 🔥 PASSWORD ZIP ANDA (Sesuai request) 🔥
ZIP_PASS="Tunnelftdor"

# Path Sementara
TMP_DIR="/tmp/update_vps"
mkdir -p "$TMP_DIR"

# Path API Produksi
API_PROD_DIR="/etc/zivpn"
API_PROD_FILE="$API_PROD_DIR/api.js"
API_SERVICE="zivpn" 

print_header

# ============================
# 1. PERSIAPAN SISTEM
# ============================
echo -e " ${CY}➤${NC} ${WH}Memeriksa Paket Pendukung...${NC}"
apt-get install unzip dos2unix jq curl -y >/dev/null 2>&1
loading_bar 15

# ============================
# 2. UPDATE SCRIPTS (PROJECT.ZIP)
# ============================
echo -e " ${CY}➤${NC} ${WH}Mengunduh & Mengekstrak Script VPS...${NC}"
wget -q -O "$TMP_DIR/project.zip" "$ZIP_URL"

if [ ! -s "$TMP_DIR/project.zip" ]; then
    echo -e " ${RD}✗ Gagal mengunduh project.zip!${NC}"
    rm -rf "$TMP_DIR"
    exit 1
else
    echo -e " ${YL}➤${NC} ${WH}Mengekstrak File (Password Protected)...${NC}"
    
    # PERUBAHAN DISINI: Menambahkan -P "$ZIP_PASS"
    # -P : Memasukkan password
    # -o : Overwrite (timpa file lama)
    # -j : Junk paths (buang folder, ambil filenya saja)
    
    if unzip -P "$ZIP_PASS" -o -j "$TMP_DIR/project.zip" -d /usr/bin/ >/dev/null 2>&1; then
        
        # Masuk ke direktori bin untuk setting permission
        cd /usr/bin
        
        # Berikan izin eksekusi ke file-file penting
        chmod +x exp apidelete apidelete-zivpn autokill autokill-zivpn \
                 dellssh dellvmess dellvless delltrojan dellshadowsocks \
                 menu apicreate apicreate-zivpn trial* update 2>/dev/null
        
        # Konversi format baris Windows (CRLF) ke Linux (LF)
        dos2unix exp apidelete apidelete-zivpn autokill autokill-zivpn \
                 dellssh dellvmess dellvless delltrojan dellshadowsocks \
                 menu apicreate apicreate-zivpn trial* update >/dev/null 2>&1

        echo -e " ${GR}✓ Script VPS Berhasil Diperbarui${NC}"
    else
        echo -e " ${RD}✗ Gagal Ekstrak! Password ZIP Salah atau File Corrupt.${NC}"
        echo -e " ${RD}   Pastikan password di script ini sesuai dengan project.zip${NC}"
        exit 1
    fi
fi
loading_bar 40

# ============================
# 3. UPDATE API BACKEND (API.JS)
# ============================
echo -e " ${CY}➤${NC} ${WH}Memperbarui Backend API (api.js)...${NC}"
wget -q -O "$TMP_DIR/api.js" "$API_URL"

if [ -s "$TMP_DIR/api.js" ]; then
    if grep -q "const" "$TMP_DIR/api.js" || grep -q "express" "$TMP_DIR/api.js"; then
        
        cp "$TMP_DIR/api.js" "$API_PROD_FILE"
        chmod 644 "$API_PROD_FILE"
        
        echo -e " ${YL}➤${NC} ${WH}Merestart Service ZiVPN...${NC}"
        systemctl restart "$API_SERVICE"
        
        if systemctl is-active --quiet "$API_SERVICE"; then
             echo -e " ${GR}✓ API Backend Berhasil Diupdate & Running${NC}"
        else
             echo -e " ${RD}⚠️ Service Gagal Start. Cek Log: journalctl -u $API_SERVICE${NC}"
        fi
    else
        echo -e " ${RD}✗ File api.js tidak valid${NC}"
    fi
else
    echo -e " ${RD}✗ Gagal download api.js${NC}"
fi
loading_bar 40

# ============================
# CLEANUP & FINISH
# ============================
rm -rf "$TMP_DIR"

echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${GR}✓ UPDATE MASTER SELESAI${NC}"
echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""