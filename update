#!/bin/bash

# ============================
# WARNA & VISUAL
# ============================
GR="\e[38;5;82m"
RD="\e[38;5;196m"
YL="\e[38;5;226m"
CY="\e[38;5;51m"
PR="\e[38;5;207m"
WH="\e[97m"
NC="\e[0m"

loading_bar() {
    local total=$1; local current=0; local width=40
    while [ "$current" -le "$total" ]; do
        local filled=$((current * width / total))
        local empty=$((width - filled))
        local bar=$(printf "%${filled}s" | tr ' ' "▰")
        bar+=$(printf "%${empty}s" | tr ' ' "▱")
        printf "\r ${CY}[${bar}]${NC} ${WH}%d%%${NC}" $((current * 100 / total))
        sleep 0.05; ((current++))
    done
    echo -e "\n"
}

print_header() {
    clear
    echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "          ${WH}PREMIUM UPDATE — TUNNEL OFFICIAL EDITION${NC}"
    echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ============================
# KONFIGURASI URL (FIXED)
# ============================
# Mengarah ke repo mudziboy/tunv2 folder project
ZIP_URL="https://raw.githubusercontent.com/mudziboy/tunv2/main/project/project.zip"
# Mengarah ke repo mudziboy/doldol file api.js
API_URL="https://raw.githubusercontent.com/mudziboy/doldol/main/api.js"

# Path Sementara
TMP_DIR="/tmp/update_vps"
mkdir -p "$TMP_DIR"

# Path Produksi (Sesuai setup VPS Anda sebelumnya)
API_PROD_DIR="/etc/zivpn"
API_PROD_FILE="$API_PROD_DIR/api.js"
API_SERVICE="zivpn" # Nama service systemd

print_header

# ============================
# 1. PERSIAPAN SISTEM
# ============================
echo -e " ${CY}➤${NC} ${WH}Memeriksa Paket Pendukung...${NC}"
# Install unzip dan dos2unix agar file zip terbaca sempurna
apt-get install unzip dos2unix jq curl -y >/dev/null 2>&1
loading_bar 15

# ============================
# 2. UPDATE SCRIPTS (PROJECT.ZIP)
# ============================
echo -e " ${CY}➤${NC} ${WH}Mengunduh & Mengekstrak Script VPS...${NC}"
wget -q -O "$TMP_DIR/project.zip" "$ZIP_URL"

# Validasi ukuran file (mencegah file kosong/404 terinstall)
if [ ! -s "$TMP_DIR/project.zip" ]; then
    echo -e " ${RD}✗ Gagal mengunduh project.zip! Periksa URL GitHub.${NC}"
    echo -e " ${RD}   URL: $ZIP_URL${NC}"
    rm -rf "$TMP_DIR"
    exit 1
else
    # Ekstrak semua file langsung ke /usr/bin/ dengan opsi overwrite (-o)
    # Menggunakan -j (junk paths) agar jika Anda zip folder, isinya tetap masuk root /usr/bin
    echo -e " ${YL}➤${NC} ${WH}Menginstalasi File ke System...${NC}"
    unzip -o -j "$TMP_DIR/project.zip" -d /usr/bin/ >/dev/null 2>&1
    
    # Fix Permission & Line Endings (PENTING untuk file dari Windows/Zip)
    # Kita asumsikan semua file di zip adalah script yang perlu dijalankan
    cd /usr/bin
    
    # List file umum yang ada di project Anda untuk di-chmod
    # Tambahkan nama file lain jika ada
    chmod +x exp apidelete apidelete-zivpn autokill autokill-zivpn \
             dellssh dellvmess dellvless delltrojan dellshadowsocks \
             menu apicreate apicreate-zivpn trial* 2>/dev/null
    
    # Konversi format baris Windows (CRLF) ke Linux (LF) untuk semua script
    dos2unix exp apidelete apidelete-zivpn autokill autokill-zivpn \
             dellssh dellvmess dellvless delltrojan dellshadowsocks \
             menu apicreate apicreate-zivpn trial* >/dev/null 2>&1

    echo -e " ${GR}✓ Script VPS Berhasil Diperbarui${NC}"
fi
loading_bar 40

# ============================
# 3. UPDATE API BACKEND (API.JS)
# ============================
echo -e " ${CY}➤${NC} ${WH}Memperbarui Backend API (api.js)...${NC}"
wget -q -O "$TMP_DIR/api.js" "$API_URL"

if [ -s "$TMP_DIR/api.js" ]; then
    # Cek sederhana isi file (memastikan bukan HTML 404)
    if grep -q "express" "$TMP_DIR/api.js" || grep -q "const" "$TMP_DIR/api.js"; then
        
        # Backup file lama (opsional, untuk safety)
        cp "$API_PROD_FILE" "${API_PROD_FILE}.bak" 2>/dev/null
        
        # Timpa file produksi
        cp "$TMP_DIR/api.js" "$API_PROD_FILE"
        chmod 644 "$API_PROD_FILE"
        
        echo -e " ${YL}➤${NC} ${WH}Merestart Service ZiVPN...${NC}"
        systemctl restart "$API_SERVICE"
        
        # Cek status service
        if systemctl is-active --quiet "$API_SERVICE"; then
             echo -e " ${GR}✓ API Backend Berhasil Diupdate & Running${NC}"
        else
             echo -e " ${RD}⚠️ API Update Berhasil tapi Service Gagal Start${NC}"
             echo -e " ${WH}   Cek log: journalctl -u $API_SERVICE -n 20${NC}"
        fi
    else
        echo -e " ${RD}✗ File api.js korup/tidak valid (Isi bukan kode JS)${NC}"
    fi
else
    echo -e " ${RD}✗ Gagal download api.js (File kosong)${NC}"
    echo -e " ${RD}   URL: $API_URL${NC}"
fi
loading_bar 40

# ============================
# CLEANUP & FINISH
# ============================
rm -rf "$TMP_DIR"

echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${GR}✓ UPDATE MASTER SELESAI${NC}"
echo -e " ${WH}Semua file dari project.zip telah diekstrak ke /usr/bin${NC}"
echo -e " ${WH}API Backend telah diperbarui dari repo doldol${NC}"
echo -e "${PR}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""