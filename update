#!/bin/bash
# UPDATE MASTER - AUTO PERMISSION, IP VALIDATION & DEPENDENCY FIX

# KONFIGURASI
ZIP_URL="https://raw.githubusercontent.com/mudziboy/tunv2/main/project/project.zip"
API_URL="https://raw.githubusercontent.com/mudziboy/doldol/main/api.js"
IZIN_URL="https://raw.githubusercontent.com/mudziboy/regist/main/izin"
ZIP_PASS="Tunnelftdor"

TMP_DIR="/tmp/update_vps"
EXTRACT_DIR="$TMP_DIR/extracted"
API_PROD_DIR="/etc/zivpn"
API_PROD_FILE="$API_PROD_DIR/api.js"

# WARNA
CY="\e[38;5;51m"; GR="\e[38;5;82m"; RD="\e[38;5;196m"; YL="\e[38;5;226m"; NC="\e[0m"

clear
echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "   UPDATE SYSTEM & AUTO-FIX BUG   "
echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# 0. LOGIKA IZIN IP (VALIDASI VPS)
echo -e " ${CY}➤${NC} Memvalidasi Izin IP VPS..."
vps_ip=$(curl -s ipinfo.io/ip)
data_izin=$(curl -s "$IZIN_URL")
check_izin=$(echo "$data_izin" | grep "$vps_ip")

if [ -z "$check_izin" ]; then
    echo -e " ${RD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e " ${RD}   AKSES DITOLAK! IP TIDAK TERDAFTAR      ${NC}"
    echo -e " ${RD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
else
    # Simpan Key terbaru ke file jika diperlukan seperti di setup
    key_izin=$(echo "$check_izin" | awk '{print $2}')
    echo "$key_izin" > /root/.key
    echo -e " ${GR}✓ IP Terverifikasi: $vps_ip${NC}"
fi

# 1. SETUP FOLDER
rm -rf "$TMP_DIR"
mkdir -p "$EXTRACT_DIR"
mkdir -p "$API_PROD_DIR"

# 2. UPDATE SCRIPT VPS
echo -e " ${CY}➤${NC} Mengunduh Scripts..."
wget -q -O "$TMP_DIR/project.zip" "$ZIP_URL"

if [ -s "$TMP_DIR/project.zip" ]; then
    echo -e " ${CY}➤${NC} Mengekstrak..."
    if unzip -P "$ZIP_PASS" -o -j "$TMP_DIR/project.zip" -d "$EXTRACT_DIR" >/dev/null 2>&1; then
        echo -e " ${CY}➤${NC} Mengatur Izin File & Format..."
        # Berikan izin eksekusi ke SEMUA file hasil ekstrak [cite: 132]
        chmod -R +x "$EXTRACT_DIR"/*
        # Perbaikan dos2unix untuk menghindari error format 
        if command -v dos2unix &> /dev/null; then
            find "$EXTRACT_DIR" -type f -exec dos2unix {} \; >/dev/null 2>&1
        else
            find "$EXTRACT_DIR" -type f -exec sed -i 's/\r$//' {} \; >/dev/null 2>&1
        fi
        
        # Pindahkan ke /usr/bin 
        mv -f "$EXTRACT_DIR"/* /usr/bin/
        echo -e " ${GR}✓ Script berhasil diperbarui.${NC}"
    else
        echo -e " ${RD}✗ Password ZIP salah atau file korup.${NC}"
    fi
else
    echo -e " ${RD}✗ Gagal download project.zip${NC}"
fi

# 3. UPDATE API ZIVPN & DEPENDENCY
echo -e " ${CY}➤${NC} Update API Backend..."
wget -q -O "$TMP_DIR/api.js" "$API_URL"

if [ -s "$TMP_DIR/api.js" ] && grep -q "express" "$TMP_DIR/api.js"; then
    cp "$TMP_DIR/api.js" "$API_PROD_FILE"
    
    cd "$API_PROD_DIR" || exit
    
    # Inisialisasi npm jika belum ada untuk menghindari "module not found"
    if [ ! -f "package.json" ]; then
        npm init -y >/dev/null 2>&1
    fi
    
    # Pastikan express terinstall 
    if [ ! -d "node_modules/express" ]; then
        echo -e " ${CY}➤${NC} Menginstal dependensi Express..."
        npm install express >/dev/null 2>&1
    fi

    # Pastikan PM2 Terinstall 
    if ! command -v pm2 &> /dev/null; then
        npm install pm2 -g >/dev/null 2>&1
    fi

    # Jalankan API dengan PM2 
    pm2 delete zivpn-api >/dev/null 2>&1
    pm2 start "$API_PROD_FILE" --name "zivpn-api"
    pm2 save >/dev/null 2>&1
    
    # Health Check internal
    sleep 2
    if curl -s http://127.0.0.1:5889/health | grep -q "ok"; then
        echo -e " ${GR}✓ API Backend Updated & Verified.${NC}"
    else
        echo -e " ${YL}⚠ API Started, but port 5889 not responding.${NC}"
    fi
else
    echo -e " ${RD}✗ API Backend gagal diunduh atau file tidak valid.${NC}"
fi

# 4. MEMBERSIHKAN LOG EXPIRED (Instan)
echo -e " ${CY}➤${NC} Menjalankan Pembersihan Awal..."
/usr/bin/exp >/dev/null 2>&1

rm -rf "$TMP_DIR"
echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${GR}UPDATE SELESAI${NC}"
echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
