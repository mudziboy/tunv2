#!/bin/bash

# ============================
# WARNA & LOADING
# ============================
GR="\e[38;5;82m"
RD="\e[38;5;196m"
YL="\e[38;5;226m"
CY="\e[38;5;51m"
WH="\e[97m"
NC="\e[0m"

loading_bar() {
    local total=$1; local current=0; local width=40
    while [ "$current" -le "$total" ]; do
        local filled=$((current * width / total))
        local empty=$((width - filled))
        local bar=$(printf "%${filled}s" | tr ' ' "▰")
        bar+=$(printf "%${empty}s" | tr ' ' "▱")
        printf "\r ${CY}[${bar}]${NC} ${WH}%d%%${NC}" $((current * 100 / total))
        sleep 0.05; ((current++))
    done
    echo -e "\n"
}

print_header() {
    clear
    echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "          ${WH}PREMIUM UPDATE — TUNNEL OFFICIAL EDITION${NC}"
    echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# ============================
# KONFIGURASI URL & PATH
# ============================
# Pastikan URL ini mengarah ke file ZIP Anda yang berisi (exp, apidelete, dll)
ZIP_URL="https://raw.githubusercontent.com/mudziboy/tunv2/main/project.zip"
# URL untuk api.js (Backend Bot)
API_JS_URL="https://raw.githubusercontent.com/mudziboy/tunv2/main/api.js"

TMP_DIR="/tmp/update_vps"
mkdir -p "$TMP_DIR"

print_header

# ============================
# 1. UPDATE SCRIPT VPS (project.zip)
# ============================
echo -e " ${YL}➤${NC} ${WH}Downloading VPS Scripts (project.zip)...${NC}"
wget -q -O "$TMP_DIR/project.zip" "$ZIP_URL"

if [ ! -s "$TMP_DIR/project.zip" ]; then
    echo -e " ${RD}✗ Gagal mengunduh project.zip (File kosong/URL salah)${NC}"
    # Lanjut ke API update atau exit, tergantung preferensi. Disini kita lanjut.
else
    echo -e " ${YL}➤${NC} ${WH}Installing VPS Scripts...${NC}"
    
    # Install unzip jika belum ada
    if ! command -v unzip &> /dev/null; then
        apt-get install unzip -y > /dev/null 2>&1
    fi

    # Ekstrak & Timpa file lama
    unzip -o "$TMP_DIR/project.zip" -d "$TMP_DIR/" > /dev/null 2>&1
    
    # Pindahkan file penting ke /usr/bin
    # Pastikan di dalam zip tidak ada folder, langsung file. 
    # Jika ada folder, sesuaikan pathnya.
    
    cp -f "$TMP_DIR/exp" /usr/bin/exp
    cp -f "$TMP_DIR/apidelete" /usr/bin/apidelete
    cp -f "$TMP_DIR/apidelete-zivpn" /usr/bin/apidelete-zivpn
    cp -f "$TMP_DIR/autokill-zivpn" /usr/bin/autokill-zivpn
    cp -f "$TMP_DIR/autokill" /usr/bin/autokill
    cp -f "$TMP_DIR/dellssh" /usr/bin/dellssh
    cp -f "$TMP_DIR/dellvmess" /usr/bin/dellvmess
    # ... Tambahkan file lain jika perlu ...

    # Fix Izin Eksekusi & Format Windows
    chmod +x /usr/bin/exp
    chmod +x /usr/bin/apidelete
    chmod +x /usr/bin/apidelete-zivpn
    chmod +x /usr/bin/autokill*
    chmod +x /usr/bin/dell*
    
    # Anti-Windows (CRLF to LF)
    sed -i 's/\r$//' /usr/bin/exp
    sed -i 's/\r$//' /usr/bin/apidelete
    sed -i 's/\r$//' /usr/bin/apidelete-zivpn

    echo -e " ${GR}✓ Script VPS Berhasil Diperbarui${NC}"
fi

loading_bar 25

# ============================
# 2. UPDATE API BOT (api.js)
# ============================
echo -e " ${YL}➤${NC} ${WH}Updating API Backend (api.js)...${NC}"

# Path di mana api.js berjalan (Sesuaikan jika beda)
API_PROD_DIR="/etc/zivpn"      
API_PROD_FILE="$API_PROD_DIR/api.js"
API_SERVICE="zivpn"            # Nama service systemd

# Download api.js baru
wget -q -O "$TMP_DIR/api.js" "$API_JS_URL"

if [ -s "$TMP_DIR/api.js" ]; then
    # Cek validitas file sederhana
    if grep -q "createzivpn" "$TMP_DIR/api.js"; then
        cp "$TMP_DIR/api.js" "$API_PROD_FILE"
        chmod 644 "$API_PROD_FILE"
        
        echo -e " ${YL}➤${NC} ${WH}Restarting API Service...${NC}"
        systemctl restart "$API_SERVICE"
        echo -e " ${GR}✓ API Backend Berhasil Diperbarui${NC}"
    else
        echo -e " ${RD}✗ File api.js korup atau tidak valid${NC}"
    fi
else
    echo -e " ${RD}✗ Gagal download api.js${NC}"
fi

loading_bar 10

# ============================
# CLEANUP
# ============================
rm -rf "$TMP_DIR"

echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${GR}✓ UPDATE SELESAI — SISTEM TELAH DIPERBARUI${NC}"
echo -e "${CY}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e ""